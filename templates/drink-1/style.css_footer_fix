/* Pre-Footer Services */
.pre-footer-services {
    padding: 80px 0 0;
    background: #fff;
    overflow: hidden;
}

.services-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
}

.services-title {
    font-size: 24px;
    font-weight: 800;
    margin-bottom: 30px;
    color: var(--dark);
}

.service-item {
    display: flex;
    gap: 20px;
    margin-bottom: 25px;
    align-items: center;
}

.service-item img {
    width: 45px;
    height: 45px;
}

.service-item .text strong {
    display: block;
    font-size: 15px;
    margin-bottom: 5px;
    color: var(--dark);
}

.service-item .text span {
    font-size: 13px;
    color: #888;
}

.services-visual {
    position: relative;
    text-align: center;
}

.delivery-man {
    max-height: 500px;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.1));
}

.animated-bg {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 80%;
    background: url('https://img.freepik.com/free-vector/city-skyline-background-vector_53876-140504.jpg') no-repeat bottom center;
    background-size: contain;
    z-index: 1;
    opacity: 0.1;
}

.newsletter-overlap {
    background: #9c845e;
    padding: 40px 60px;
    border-radius: 40px 40px 0 40px;
    margin-top: -50px;
    position: relative;
    z-index: 10;
    color: #fff;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
}

.newsletter-inner h3 {
    font-size: 22px;
    margin-bottom: 10px;
    font-weight: 700;
}

.newsletter-inner p {
    font-size: 14px;
    opacity: 0.8;
    margin-bottom: 25px;
}

.newsletter-input-group {
    display: flex;
    gap: 15px;
}

.newsletter-input-group input {
    flex: 1;
    padding: 15px 25px;
    border-radius: 30px;
    border: none;
    outline: none;
    font-size: 14px;
}

.newsletter-input-group button {
    padding: 0 40px;
    background: #f1c40f;
    color: var(--dark);
    border: none;
    border-radius: 30px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.3s ease;
}

.newsletter-input-group button:hover {
    background: #fff;
    transform: translateY(-2px);
}

/* Main Footer */
.main-footer {
    background: #0b0d17;
    color: #fff;
    padding-top: 120px;
    padding-bottom: 30px;
}

.footer-main-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 60px;
}

.footer-logo {
    font-size: 26px;
    font-weight: 900;
    color: #fff;
    text-decoration: none;
    margin-bottom: 25px;
    display: block;
    letter-spacing: 1px;
}

.footer-desc {
    font-size: 14px;
    line-height: 1.7;
    opacity: 0.6;
    margin-bottom: 30px;
}

.footer-contact {
    list-style: none;
}

.footer-contact li {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
    font-size: 14px;
    opacity: 0.7;
}

.footer-contact li i {
    width: 20px;
    color: #9c845e;
}

.footer-col h4 {
    margin-bottom: 25px;
    font-size: 16px;
    font-weight: 700;
}

.footer-col ul {
    list-style: none;
}

.footer-col ul li {
    margin-bottom: 12px;
}

.footer-col ul li a {
    color: #fff;
    opacity: 0.5;
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s;
}

.footer-col ul li a:hover {
    opacity: 1;
    padding-left: 5px;
    color: #9c845e;
}

.footer-bottom-widgets {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: 40px;
    padding: 50px 0;
    border-top: 1px solid rgba(255,255,255,0.05);
}

.widget-item h4 {
    margin-bottom: 25px;
    font-size: 16px;
    font-weight: 700;
}

.hotline-line {
    margin-bottom: 20px;
}

.hotline-line p {
    font-size: 14px;
    opacity: 0.6;
    margin-bottom: 5px;
}

.phone-link {
    font-size: 20px;
    font-weight: 800;
    color: var(--accent);
    display: block;
}

.social-links {
    display: flex;
    gap: 12px;
}

.social-icon {
    width: 45px;
    height: 45px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    text-decoration: none;
    font-size: 20px;
    transition: transform 0.3s ease;
}

.social-icon:hover {
    transform: translateY(-5px);
}

.social-icon.fb { background: #3b5998; }
.social-icon.ins { background: #e1306c; }
.social-icon.shopee { background: #ee4d2d; }
.social-icon.tiktok { background: #000; }

.payment-icons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.payment-icons img {
    height: 32px;
    background: #fff;
    padding: 4px;
    border-radius: 6px;
}

.footer-copyright {
    padding-top: 40px;
    border-top: 1px solid rgba(255,255,255,0.05);
    text-align: center;
    font-size: 13px;
    opacity: 0.4;
}

@media (max-width: 992px) {
    .services-wrapper { grid-template-columns: 1fr; }
    .footer-main-content { grid-template-columns: 1fr 1fr; }
    .footer-bottom-widgets { grid-template-columns: 1fr; gap: 30px; }
    .newsletter-overlap { padding: 30px; }
    .newsletter-input-group { flex-direction: column; }
}
